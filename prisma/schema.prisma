// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. TABELAS DE APOIO E CLASSIFICAÇÃO
// ==========================================

enum TipoLigacao {
  SERIE
  PARALELO
  BYPASS
}

enum TipoEquipamento {
  BOMBA
  COMPRESSOR
  MOTOR
  VALVULA
  TANQUE
  PERMUTADOR
  INSTRUMENTO
  OUTROS
}

model abc {
  idcriticidade Int           @id @default(autoincrement())
  nivel         String        @unique
  equipamentos  Equipamento[]
}

model xyz {
  idxyz        Int           @id @default(autoincrement())
  nivel        String        @unique
  equipamentos Equipamento[]
}

model CausaRaiz {
  idcausaraiz  String  @id @default(uuid())
  nome         String  @unique
  descricao    String?
  falhas       Falha[]   
}

// ==========================================
// 2. HIERARQUIA ESPACIAL DA PLANTA
// ==========================================

model Planta {
  idplanta String  @id @default(uuid())
  nome     String
  isActive Boolean @default(true) // 🟢 ADICIONADO
  
  setores  Setor[]
}

model Setor {
  idsetor   String @id @default(uuid())
  nome      String
  isActive  Boolean @default(true)

  plantaId  String?
  planta    Planta? @relation(fields: [plantaId], references: [idplanta])

  blocos    DiagramaBloco[]
  conexoes  DiagramaConexao[]
  
  // 🟢 Renomeado para minúsculo para padrão camelCase
  equipamentos Equipamento[] 
}

// ==========================================
// 3. EQUIPAMENTOS E OCORRÊNCIAS
// ==========================================

model Equipamento {
  idequipamentos    String          @id @default(uuid())
  nome              String
  tipo              TipoEquipamento @default(OUTROS)
  tag               String          @unique
  fabricante        String
  modelo            String
  data_instalacao   DateTime
  status            String          @default("OPERANDO")
  isActive          Boolean         @default(true)
  
  abc_idcriticidade Int
  xyz_idxyz         Int
  
  // 🟢 FK Alterada para setorId
  setorId           String?
  
  abc               abc             @relation(fields: [abc_idcriticidade], references: [idcriticidade])
  xyz               xyz             @relation(fields: [xyz_idxyz], references: [idxyz])
  
  // 🟢 Relação atualizada usando o novo nome da FK
  setor             Setor?           @relation(fields: [setorId], references: [idsetor])

  falhas            Falha[]
  planos            EquipamentoTemPlano[]
  blocos_visuais    DiagramaBloco[] 
}

model Falha {
  idfalhas           String       @id @default(uuid())
  data_hora_falha    DateTime     @default(now())
  data_hora_reparo   DateTime?
  descricao          String       
  tempo_parada_horas Float?
  isActive           Boolean      @default(true)
  
  equipamento_id     String
  equipamento        Equipamento  @relation(fields: [equipamento_id], references: [idequipamentos])
  
  causa_raiz_id      String?      
  causa_raiz         CausaRaiz?   @relation(fields: [causa_raiz_id], references: [idcausaraiz])
}

// ==========================================
// 4. PLANOS DE MANUTENÇÃO (PREVENTIVA)
// ==========================================

model Plano {
  idplanos           String                @id @default(uuid())
  tipo_manutencao    String                
  periocidade_dias   Int                   
  isActive           Boolean               @default(true)

  tarefas            Tarefa[]              
  equipamentos       EquipamentoTemPlano[] 
  
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model Tarefa {
  idtarefas          String   @id @default(uuid())
  ordem              Int      
  tarefa             String   
  tempo_execucao     Float?   
  descricao          String?  
  isActive           Boolean  @default(true)
  
  planos_idplanos    String
  plano              Plano    @relation(fields: [planos_idplanos], references: [idplanos])
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Tabela Intermediária (A Prancheta de Agendamento individual)
model EquipamentoTemPlano {
  idequipamentos_tem_planos   String      @id @default(uuid())
  isActive                    Boolean     @default(true)

  equipamentos_idequipamentos String
  planos_idplanos             String
  
  ultima_execucao             DateTime?
  proxima_execucao            DateTime?
  
  equipamento                 Equipamento @relation(fields: [equipamentos_idequipamentos], references: [idequipamentos])
  plano                       Plano       @relation(fields: [planos_idplanos], references: [idplanos])

  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  @@unique([equipamentos_idequipamentos, planos_idplanos])
}

// ==========================================
// 5. DIGITAL TWIN (DIAGRAMA DE BLOCOS)
// ==========================================

// O "Quadradinho" desenhado na tela
model DiagramaBloco {
  id_bloco         String            @id @default(uuid())
  tipo_bloco       String            @default("default") // 🟢 ADICIONADO AQUI
  posicao_x        Float
  posicao_y        Float
  
  // A qual tela/setor este desenho pertence?
  setorId          String
  setor            Setor             @relation(fields: [setorId], references: [idsetor])
  
  // Qual máquina real ele representa? (Pode ser nulo para blocos visuais simples)
  equipamentoId    String?
  equipamento      Equipamento?      @relation(fields: [equipamentoId], references: [idequipamentos])

  // Linhas que ligam este bloco aos outros
  conexoesSaindo   DiagramaConexao[] @relation("BlocoOrigem")
  conexoesEntrando DiagramaConexao[] @relation("BlocoDestino")
}

// A "Linha" que liga os blocos e define a matemática da confiabilidade
model DiagramaConexao {
  id_conexao       String        @id @default(uuid())
  tipo_ligacao     TipoLigacao   @default(SERIE)
  
  setorId          String
  setor            Setor         @relation(fields: [setorId], references: [idsetor])

  blocoOrigemId    String
  blocoOrigem      DiagramaBloco @relation("BlocoOrigem", fields: [blocoOrigemId], references: [id_bloco])
  
  blocoDestinoId   String
  blocoDestino     DiagramaBloco @relation("BlocoDestino", fields: [blocoDestinoId], references: [id_bloco])
}